[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://course.playlab.tw/git/weifen/git-demo
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
	vscode-merge-base = origin/main
[branch "dev/procat/git-demo"]
	vscode-merge-base = origin/main
	remote = origin
	merge = refs/heads/dev/procat/git-demo
